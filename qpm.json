{
  "$schema": "https://raw.githubusercontent.com/QuestPackageManager/QPM.Package/refs/heads/main/qpm.schema.json",
  "version": "0.6.3",
  "sharedDir": "shared",
  "dependenciesDir": "extern",
  "info": {
    "name": "Big Screen",
    "id": "bigscreen",
    "version": "0.6.3",
    "url": null,
    "additionalData": {
      "overrideSoName": "libbigscreen.so",
      "cmake": true
    }
  },
  "workspace": {
    "scripts": {
      "build": [
        "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/build.ps1"
      ],
      "clean": [
        "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/build.ps1 -clean"
      ],
      "copy": [
        "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/copy.ps1 $0:?"
      ],
      "logcat": [
        "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-logging.ps1"
      ],
      "qmod": [
        "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/build.ps1",
        "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/createqmod.ps1"
      ],
      "restart": [
        "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/restart-game.ps1"
      ],
      "stack": [
        "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/ndk-stack.ps1"
      ],
      "tomb": [
        "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/pull-tombstone.ps1"
      ]
    },
    "qmodIncludeDirs": [
      "./build",
      "./extern/libs"
    ],
    "qmodIncludeFiles": [],
    "qmodOutput": "./Big Screen.qmod"
  },
  "dependencies": [
    {
      "id": "beatsaber-hook",
      "versionRange": "=5.1.9",
      "additionalData": {}
    },
    {
      "id": "scotland2",
      "versionRange": "=0.1.4",
      "additionalData": {
        "includeQmod": false
      }
    },
    {
      "id": "paper",
      "versionRange": "=3.7.0",
      "additionalData": {}
    },
    {
      "id": "bs-cordl",
      "versionRange": "=3700.0.0",
      "additionalData": {}
    },
    {
      "id": "songcore",
      "versionRange": "=1.1.16",
      "additionalData": {}
    },
    {
      "id": "hollywood",
      "versionRange": "=1.0.1",
      "additionalData": {}
    },
    {
      "id": "rapidjson",
      "versionRange": "^0.1.20250205132808",
      "additionalData": {}
    },
    {
      "id": "bsml",
      "versionRange": "=0.4.43",
      "additionalData": {}
    },
    {
      "id": "custom-types",
      "versionRange": "=0.17.10",
      "additionalData": {}
    }
  ]
}
