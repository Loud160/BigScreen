{
  "$schema": "https://raw.githubusercontent.com/QuestPackageManager/QPM.Package/refs/heads/main/qpm.schema.json",
  "version": "0.7.0-alpha.11",
  "sharedDir": "shared",
  "dependenciesDir": "extern",
  "info": {
    "name": "Big Screen",
    "id": "bigscreen",
    "version": "0.7.0-alpha.11",
    "url": "https://github.com/Loud160/BigScreen",
    "additionalData": {
      "overrideSoName": "libbigscreen.so",
      "cmake": true
    }
  },
  "workspace": {
    "ndk": "^27.3.13750724",
    "scripts": {
      "build": [
        "bash ./scripts/build-linux.sh"
      ],
      "clean": [
        "bash ./scripts/build-linux.sh --clean"
      ],
      "copy": [
        "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/copy.ps1 $0:?"
      ],
      "logcat": [
        "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-logging.ps1"
      ],
      "qmod": [
        "bash ./scripts/build-linux.sh"
      ],
      "restart": [
        "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/restart-game.ps1"
      ],
      "stack": [
        "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/ndk-stack.ps1"
      ],
      "tomb": [
        "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/pull-tombstone.ps1"
      ]
    },
    "qmodIncludeDirs": [
      "./build",
      "./extern/libs"
    ],
    "qmodIncludeFiles": [],
    "qmodOutput": "./Big Screen.qmod"
  },
  "dependencies": [
    {
      "id": "beatsaber-hook",
      "versionRange": "^6.4.2",
      "additionalData": {}
    },
    {
      "id": "scotland2",
      "versionRange": "^0.1.6",
      "additionalData": {
        "includeQmod": false
      }
    },
    {
      "id": "paper2_scotland2",
      "versionRange": "^4.8.0",
      "additionalData": {}
    },
    {
      "id": "bs-cordl",
      "versionRange": "4008.*",
      "additionalData": {}
    },
    {
      "id": "songcore",
      "versionRange": "^1.1.23",
      "additionalData": {}
    },
    {
      "id": "rapidjson",
      "versionRange": "^0.1.20250205132808",
      "additionalData": {}
    },
    {
      "id": "bsml",
      "versionRange": "^0.4.54",
      "additionalData": {}
    },
    {
      "id": "custom-types",
      "versionRange": "^0.18.3",
      "additionalData": {}
    }
  ]
}
